# Builds the ARM64 UEFI helpers and regenerates ../../Macaroon/WindowsEFIBinaries.swift (base64, no bundle resources).
# Needs Homebrew LLVM (lld-link). Run `make` after changing the C sources; the generated Swift file is committed.
LLVM ?= /opt/homebrew/opt/llvm@18/bin
CFLAGS = -target aarch64-unknown-windows -ffreestanding -fshort-wchar -fno-builtin -fno-stack-protector -mno-implicit-float -O2 -Wall -Wextra -Wno-unused-parameter
OUTPUT = ../../Macaroon/WindowsEFIBinaries.swift

all: $(OUTPUT)

%.o: %.c efi.h
	clang $(CFLAGS) -c $< -o $@

framebuffer.efi: framebuffer.o
	$(LLVM)/lld-link /nologo /Brepro /nodefaultlib /dll /entry:efi_main /subsystem:efi_boot_service_driver /out:$@ $<

loader.efi: loader.o
	$(LLVM)/lld-link /nologo /Brepro /nodefaultlib /dll /entry:efi_main /subsystem:efi_application /out:$@ $<

$(OUTPUT): framebuffer.efi loader.efi Makefile
	@printf '// Generated by Tools/WindowsEFI/Makefile, do not edit.\n\nimport Foundation\n\n' > $@
	@printf '/// ARM64 UEFI helpers for Windows guests (Tools/WindowsEFI).\nenum WindowsEFIBinaries {\n' >> $@
	@printf '    /// Boot service driver that gives Windows a linear framebuffer (framebuffer.c).\n' >> $@
	@printf '    static let framebuffer = Data(base64Encoded: "%s")!\n' "$$(openssl base64 -A -in framebuffer.efi)" >> $@
	@printf '    /// BOOTAA64.EFI: starts the driver, then Windows Boot Manager (loader.c).\n' >> $@
	@printf '    static let loader = Data(base64Encoded: "%s")!\n}\n' "$$(openssl base64 -A -in loader.efi)" >> $@

clean:
	rm -f *.efi *.o *.lib

.PHONY: all clean
