+#ifdef __APPLE__
+/* macOS has neither EGL nor GLX: hand virglrenderer CGL contexts (OpenGL 4.1 core on Metal). */
+#include <OpenGL/OpenGL.h>
+
+static CGLContextObj vtest_cgl_root;
+
+static virgl_renderer_gl_context vtest_cgl_create(UNUSED void *cookie, UNUSED int scanout_idx,
+                                                  struct virgl_renderer_gl_ctx_param *param)
+{
+   if (param->major_ver > 4 || (param->major_ver == 4 && param->minor_ver > 1))
+      return NULL;
+   CGLPixelFormatAttribute attrs[] = {
+      kCGLPFAOpenGLProfile, (CGLPixelFormatAttribute)kCGLOGLPVersion_GL4_Core,
+      kCGLPFAAccelerated, kCGLPFAAllowOfflineRenderers, 0
+   };
+   CGLPixelFormatObj pix;
+   GLint count;
+   if (CGLChoosePixelFormat(attrs, &pix, &count) != kCGLNoError || !pix)
+      return NULL;
+   CGLContextObj ctx = NULL;
+   CGLCreateContext(pix, param->shared ? vtest_cgl_root : NULL, &ctx);
+   CGLReleasePixelFormat(pix);
+   if (ctx && !vtest_cgl_root)
+      vtest_cgl_root = ctx;
+   return (virgl_renderer_gl_context)ctx;
+}
+
+static void vtest_cgl_destroy(UNUSED void *cookie, virgl_renderer_gl_context ctx)
+{
+   if (ctx == (virgl_renderer_gl_context)vtest_cgl_root)
+      vtest_cgl_root = NULL;
+   CGLDestroyContext((CGLContextObj)ctx);
+}
+
+static int vtest_cgl_make_current(UNUSED void *cookie, UNUSED int scanout_idx, virgl_renderer_gl_context ctx)
+{
+   return CGLSetCurrentContext((CGLContextObj)ctx) == kCGLNoError ? 0 : -1;
+}
+#endif
+
 static struct virgl_renderer_callbacks renderer_cbs = {
    .version = VIRGL_RENDERER_CALLBACKS_VERSION,
+#ifdef __APPLE__
+   .create_gl_context = vtest_cgl_create,
+   .destroy_gl_context = vtest_cgl_destroy,
+   .make_current = vtest_cgl_make_current,
+#endif
    .write_fence = vtest_write_implicit_fence,
    .get_drm_fd = vtest_get_drm_fd,
    .write_context_fence = vtest_write_context_fence,
