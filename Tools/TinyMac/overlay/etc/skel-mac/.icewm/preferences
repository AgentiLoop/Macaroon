# TinyMac: a Mac OS 8 style desktop. The task bar is the menu bar, at the top.
Theme="Platinum/default.theme"
TaskBarAtTop=1
TaskBarShowStartMenu=1
TaskBarShowWorkspaces=0
TaskBarShowWindowListMenu=1
TaskBarShowShowDesktopButton=0
TaskBarShowCPUStatus=0
TaskBarShowMEMStatus=0
TaskBarShowNetStatus=0
TaskBarShowMailboxStatus=0
TaskBarShowAPMStatus=0
TaskBarShowTray=1
TaskBarShowWindows=0
TaskBarShowToolbar=0
ShowAddressBar=0
EnableAddressBar=0
TaskBarDoubleHeight=0
TaskBarAutoHide=0
DesktopBackgroundImage=""
MinimizeToDesktop=0
TaskBarShowClock=1
TaskBarClockLeds=0
TaskBarKeepBelow=0
TimeFormat="%a %l:%M %p"
ShowProgramsMenu=0
ShowSettingsMenu=0
ShowFocusModeMenu=0
ShowThemesMenu=0
ShowHelp=0
ShowRun=0
ShowWindowList=0
ShowAbout=0
ShowLogoutMenu=1
ShowLogoutSubMenu=1
DesktopBackgroundColor="rgb:66/66/99"
ClickToFocus=1
RaiseOnClickClient=1
SmartPlacement=1
ShutdownCommand="doas /sbin/poweroff"
RebootCommand="doas /sbin/reboot"
