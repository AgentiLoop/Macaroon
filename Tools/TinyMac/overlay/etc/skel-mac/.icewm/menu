# The Macaroon menu (top left), like the Apple menu.
prog "Finder" folder pcmanfm /home/mac
prog "Shared Folder" folder-remote pcmanfm /home/mac/Shared
prog "Trash" user-trash pcmanfm trash:///
separator
prog "SimpleText" accessories-text-editor simpletext
prog "Internet" web-browser internet
prog "Terminal" utilities-terminal xterm
separator
menu "Control Panels" preferences-desktop {
    prog "Appearance" preferences-desktop-theme xterm -e vi /home/mac/.icewm/preferences
}
