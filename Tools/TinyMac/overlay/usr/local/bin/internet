#!/usr/bin/python3
# Internet for TinyMac: a small WebKit (WebKitGTK) web browser with Mac-style menus (File, Edit, View, Go)
# and a toolbar: Back, Forward, Reload, Home and the address field. Shortcuts: Cmd or Ctrl.
import os, sys
os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "1")  # the VM's display has no GPU acceleration
os.environ.setdefault("WEBKIT_DISABLE_DMABUF_RENDERER", "1")
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, Gdk, WebKit2

HOME = "https://duckduckgo.com/"
windows = []


def address(text):
    text = text.strip()
    if "://" in text or text.startswith("about:"):
        return text
    if " " in text or "." not in text:
        return "https://duckduckgo.com/?q=" + text.replace(" ", "+")
    return "https://" + text


class Browser(Gtk.Window):
    def __init__(self, url=HOME, view=None):
        super().__init__(title="Internet")
        self.set_default_size(1000, 700)
        self.accel = Gtk.AccelGroup()
        self.add_accel_group(self.accel)
        self.web = view or WebKit2.WebView()
        self.web.get_settings().set_enable_developer_extras(True)
        self.web.connect("notify::title", lambda *_: self.set_title(self.web.get_title() or "Internet"))
        self.web.connect("notify::uri", lambda *_: self.url.set_text(self.web.get_uri() or ""))
        self.web.connect("load-changed", lambda *_: self.update_buttons())
        self.web.connect("create", lambda _, action: self.new_window(None, related=True))

        bar = Gtk.MenuBar()
        bar.append(self.menu("File", [
            ("New Window", "n", lambda: self.new_window(HOME)), ("Open Location…", "l", self.focus_address),
            ("Close", "w", self.destroy), None, ("Print…", "p", lambda: WebKit2.PrintOperation.new(self.web).run_dialog(self)),
            None, ("Quit", "q", Gtk.main_quit)]))
        bar.append(self.menu("Edit", [
            ("Cut", "x", lambda: self.web.execute_editing_command(WebKit2.EDITING_COMMAND_CUT)),
            ("Copy", "c", lambda: self.web.execute_editing_command(WebKit2.EDITING_COMMAND_COPY)),
            ("Paste", "v", lambda: self.web.execute_editing_command(WebKit2.EDITING_COMMAND_PASTE)),
            ("Select All", "a", lambda: self.web.execute_editing_command(WebKit2.EDITING_COMMAND_SELECT_ALL)), None,
            ("Find…", "f", self.find), ("Find Again", "g", lambda: self.web.get_find_controller().search_next())]))
        bar.append(self.menu("View", [
            ("Reload", "r", self.web.reload), ("Stop", "period", self.web.stop_loading), None,
            ("Larger Text", "plus", lambda: self.zoom(1.1)), ("Smaller Text", "minus", lambda: self.zoom(1 / 1.1)),
            ("Actual Size", "0", lambda: self.web.set_zoom_level(1.0))]))
        bar.append(self.menu("Go", [
            ("Back", "bracketleft", self.web.go_back), ("Forward", "bracketright", self.web.go_forward),
            ("Home", None, lambda: self.web.load_uri(HOME))]))

        tools = Gtk.Box(spacing=4, margin=4)
        self.back = self.button(tools, "go-previous", "Back", self.web.go_back)
        self.forward = self.button(tools, "go-next", "Forward", self.web.go_forward)
        self.button(tools, "view-refresh", "Reload", self.web.reload)
        self.button(tools, "go-home", "Home", lambda: self.web.load_uri(HOME))
        self.url = Gtk.Entry(placeholder_text="Type a web address or search")
        self.url.connect("activate", lambda e: self.web.load_uri(address(e.get_text())))
        tools.pack_start(self.url, True, True, 0)
        self.find_bar = Gtk.SearchEntry(placeholder_text="Find in page", no_show_all=True)
        self.find_bar.connect("search-changed", lambda e: self.web.get_find_controller().search(
            e.get_text(), WebKit2.FindOptions.CASE_INSENSITIVE | WebKit2.FindOptions.WRAP_AROUND, 1000))
        self.find_bar.connect("activate", lambda e: self.web.get_find_controller().search_next())
        self.find_bar.connect("stop-search", lambda e: (self.web.get_find_controller().search_finish(), e.hide()))
        tools.pack_start(self.find_bar, False, False, 0)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(bar, False, False, 0)
        box.pack_start(tools, False, False, 0)
        box.pack_start(self.web, True, True, 0)
        self.add(box)
        self.connect("destroy", self.closed)
        self.connect("key-press-event", lambda _, e: e.keyval == Gdk.KEY_Escape and self.web.stop_loading())
        windows.append(self)
        self.show_all()
        if url:
            self.web.load_uri(address(url))
        else:
            self.web.connect("ready-to-show", lambda *_: self.present())
        self.update_buttons()

    def menu(self, title, entries):
        menu = Gtk.Menu()
        for entry in entries:
            if entry is None:
                menu.append(Gtk.SeparatorMenuItem())
                continue
            label, key, action = entry
            item = Gtk.MenuItem(label=label)
            item.connect("activate", lambda *_, a=action: a())
            if key:
                for mod in (Gdk.ModifierType.CONTROL_MASK, Gdk.ModifierType.SUPER_MASK):  # Ctrl, and the Mac's Cmd key
                    item.add_accelerator("activate", self.accel, Gdk.keyval_from_name(key), mod,
                                         Gtk.AccelFlags.VISIBLE if mod == Gdk.ModifierType.CONTROL_MASK else 0)
            menu.append(item)
        top = Gtk.MenuItem(label=title)
        top.set_submenu(menu)
        return top

    def button(self, box, icon, tip, action):
        button = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
        button.set_tooltip_text(tip)
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.connect("clicked", lambda *_: action())
        box.pack_start(button, False, False, 0)
        return button

    def update_buttons(self):
        self.back.set_sensitive(self.web.can_go_back())
        self.forward.set_sensitive(self.web.can_go_forward())

    def focus_address(self):
        self.url.grab_focus()
        self.url.select_region(0, -1)

    def zoom(self, factor):
        self.web.set_zoom_level(min(4, max(0.3, self.web.get_zoom_level() * factor)))

    def find(self):
        self.find_bar.show()
        self.find_bar.grab_focus()

    def new_window(self, url, related=False):
        view = WebKit2.WebView.new_with_related_view(self.web) if related else None
        return Browser(url, view).web

    def closed(self, *_):
        windows.remove(self)
        if not windows:
            Gtk.main_quit()


for arg in sys.argv[1:] or [HOME]:
    Browser(arg if os.path.exists(arg) is False else "file://" + os.path.abspath(arg))
Gtk.main()
