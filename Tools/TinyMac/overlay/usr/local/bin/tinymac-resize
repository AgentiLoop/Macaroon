#!/bin/sh
# Follows the Macaroon window: when the host resizes the virtio-gpu display, its new size becomes the
# preferred mode ("+") and the old mode disappears from the list, so compare against the screen's
# current size (from the "Screen 0: ... current W x H" line) and switch X whenever they differ.
while :; do
    set -- $(xrandr 2>/dev/null | awk '/^Screen / { for (i = 1; i < NF; i++) if ($i == "current") { h = $(i + 3); sub(",", "", h); c = $(i + 1) "x" h } }
        / connected/ { o = $1 }
        /^ +[0-9]+x[0-9]+/ && /\+/ && !p { p = $1 }
        END { print o, p, c }')
    [ $# -eq 3 ] && [ "$2" != "$3" ] && xrandr --output "$1" --auto
    sleep 1
done
