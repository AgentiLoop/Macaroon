#!/usr/bin/python3
# Calculator for TinyMac: the macOS Calculator's keypad (AC, ±, %, ÷ × − +, =) with Edit > Copy / Paste.
# Typing works too: digits, . + - * / % = Enter, Backspace, Esc (clear), Cmd/Ctrl+C and V.
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

CSS = b"""
window { background: #2b2b2b; }
#display { color: white; font: 300 34px "DejaVu Sans"; padding: 8px 14px 4px 14px; }
button { border-radius: 0; border: 1px solid #2b2b2b; box-shadow: none; text-shadow: none;
         font: 20px "DejaVu Sans"; color: white; background: #5c5c5c; min-height: 52px; min-width: 60px; }
button:active { background: #8a8a8a; }
button.func { background: #3f3f3f; }
button.func:active { background: #6a6a6a; }
button.op { background: #f19a37; font-size: 24px; }
button.op:active, button.op.chosen { background: #c97a22; }
menubar { background: #dddddd; }
"""
KEYS = [["AC", "±", "%", "÷"], ["7", "8", "9", "×"], ["4", "5", "6", "−"], ["1", "2", "3", "+"], ["0", ".", "="]]
OPS = {"÷": lambda a, b: a / b, "×": lambda a, b: a * b, "−": lambda a, b: a - b, "+": lambda a, b: a + b}


def text(value):
    if value != value or abs(value) == float("inf"):
        return "Error"
    out = f"{value:.10g}"
    return out.replace("e+", "e")


class Calculator(Gtk.Window):
    def __init__(self):
        super().__init__(title="Calculator", resizable=False)
        style = Gtk.CssProvider()
        style.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.entry, self.total, self.op, self.fresh, self.buttons = "0", None, None, True, {}

        accel = Gtk.AccelGroup()
        self.add_accel_group(accel)
        bar, edit = Gtk.MenuBar(), Gtk.Menu()
        for label, key, action in (("Copy", "c", self.copy), ("Paste", "v", self.paste)):
            item = Gtk.MenuItem(label=label)
            item.connect("activate", lambda *_, a=action: a())
            for mod in (Gdk.ModifierType.CONTROL_MASK, Gdk.ModifierType.SUPER_MASK):
                item.add_accelerator("activate", accel, ord(key), mod, Gtk.AccelFlags.VISIBLE if mod == Gdk.ModifierType.CONTROL_MASK else 0)
            edit.append(item)
        top = Gtk.MenuItem(label="Edit")
        top.set_submenu(edit)
        bar.append(top)

        self.display = Gtk.Label(label="0", xalign=1, name="display", ellipsize=3)
        grid = Gtk.Grid(column_homogeneous=True)
        for row, keys in enumerate(KEYS):
            column = 0
            for key in keys:
                button = Gtk.Button(label=key, can_focus=False)
                button.get_style_context().add_class("op" if key in OPS or key == "=" else "func" if row == 0 else "num")
                button.connect("clicked", lambda _, k=key: self.press(k))
                width = 2 if key == "0" else 1
                grid.attach(button, column, row + 1, width, 1)
                column += width
                self.buttons[key] = button
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(bar, False, False, 0)
        box.pack_start(self.display, False, False, 0)
        box.pack_start(grid, True, True, 0)
        self.add(box)
        self.connect("key-press-event", self.key)
        self.connect("destroy", Gtk.main_quit)
        self.show_all()

    def show(self, value):
        self.display.set_text(value)
        self.buttons["AC"].set_label("AC" if self.entry == "0" and self.fresh else "C")
        for key in OPS:
            context = self.buttons[key].get_style_context()
            (context.add_class if key == self.op and self.fresh else context.remove_class)("chosen")

    def press(self, key):
        if key.isdigit() or key == ".":
            if self.fresh:
                self.entry, self.fresh = "0", False
            if key == "." and "." in self.entry:
                return
            self.entry = key if self.entry == "0" and key != "." else self.entry + key
        elif key == "AC":
            if self.buttons["AC"].get_label() == "C":
                self.entry, self.fresh = "0", True
            else:
                self.entry, self.total, self.op, self.fresh = "0", None, None, True
        elif key == "±":
            self.entry = self.entry[1:] if self.entry.startswith("-") else "-" + self.entry if self.entry != "0" else "0"
        elif key == "%":
            self.entry, self.fresh = text(float(self.entry) / 100), True
        elif key in OPS or key == "=":
            value = float(self.entry) if self.entry != "Error" else 0.0
            if self.op and not (self.fresh and key in OPS):
                try:
                    value = OPS[self.op](self.total, value)
                except ZeroDivisionError:
                    value = float("nan")
            self.total, self.entry, self.fresh = value, text(value), True
            self.op = key if key in OPS else None
        self.show(self.entry)

    def key(self, _, event):
        if event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SUPER_MASK):
            return False
        name, char = Gdk.keyval_name(event.keyval), chr(Gdk.keyval_to_unicode(event.keyval) or 0)
        mapped = {"/": "÷", "*": "×", "x": "×", "-": "−", "+": "+", "=": "=", "%": "%", ".": ".", ",": "."}.get(char)
        if char.isdigit():
            self.press(char)
        elif mapped:
            self.press(mapped)
        elif name in ("Return", "KP_Enter"):
            self.press("=")
        elif name == "Escape":
            self.press("AC")
        elif name == "BackSpace" and not self.fresh:
            self.entry = self.entry[:-1] or "0"
            self.show(self.entry)
        else:
            return False
        return True

    def copy(self):
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(self.display.get_text(), -1)

    def paste(self):
        pasted = (Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).wait_for_text() or "").strip().replace(",", "")
        try:
            self.entry, self.fresh = text(float(pasted)), False
        except ValueError:
            return Gdk.beep()
        self.show(self.entry)


Calculator()
Gtk.main()
