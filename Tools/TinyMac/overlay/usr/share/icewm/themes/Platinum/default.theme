# Platinum: Mac OS 8 look for IceWM. Pinstriped title bars, close box on the left,
# zoom and WindowShade boxes on the right, grey menus with a dark blue highlight.
ThemeDescription="Platinum (Mac OS 8)"
ThemeAuthor="Macaroon"
Look=flat
TitleBarHeight=20
TitleBarJustify=50
TitleButtonsSupported="xmr"
TitleButtonsLeft="x"
TitleButtonsRight="mr"
BorderSizeX=2
BorderSizeY=2
DlgBorderSizeX=2
DlgBorderSizeY=2
CornerSizeX=12
CornerSizeY=12
MenuIconSize=16
